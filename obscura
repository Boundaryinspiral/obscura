        Font                   = FONT_M,
        TextSize               = TEXT_SM,
        TextColor3             = Theme.Text,
        TextXAlignment         = Enum.TextXAlignment.Left,
        Text                   = text,
    })

    local box = new("Frame", {
        Parent           = frame,
        Position         = UDim2.fromOffset(0, 18),
