local Tab = {}
Tab.__index = Tab

function Window:CreateTab(name, iconAsset)
    name = tostring(name or "Tab")

    local btn = new("TextButton", {
        Parent                 = self.TabList,
        Name                   = name,
        Size                   = UDim2.new(1, 0, 0, 32),
        BackgroundColor3       = Theme.Bg3,
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        Text                   = "",
        AutoButtonColor        = false,
    })
    corner(btn, CORNER_MD)

    local iconImg
    if iconAsset then
        iconImg = new("ImageLabel", {
            Parent                 = btn,
            AnchorPoint            = Vector2.new(0, 0.5),
            Position               = UDim2.new(0, 10, 0.5, 0),
            Size                   = UDim2.fromOffset(14, 14),
            BackgroundTransparency = 1,
            Image                  = iconAsset,
            ImageColor3            = Theme.SubText,
        })
    end

    local label = new("TextLabel", {
        Parent                 = btn,
        BackgroundTransparency = 1,
        Position               = UDim2.fromOffset(iconAsset and 30 or 12, 0),
        Size                   = UDim2.new(1, -16, 1, 0),
        Font                   = FONT_M,
        TextSize               = TEXT_MD,
        TextColor3             = Theme.SubText,
        TextXAlignment         = Enum.TextXAlignment.Left,
        Text                   = name,
    })

    local page = new("Frame", {
        Parent                 = self.Content,
        Name                   = name,
        Size                   = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Visible                = false,
    })
    pad(page, 12, 12, 12, 12)

    local left = new("ScrollingFrame", {
        Parent                 = page,
        Name                   = "Left",
        Size                   = UDim2.new(0.5, -6, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        ScrollBarThickness     = 3,
        ScrollBarImageColor3   = Theme.Border,
        CanvasSize             = UDim2.new(),
        AutomaticCanvasSize    = Enum.AutomaticSize.Y,
        ScrollingDirection     = Enum.ScrollingDirection.Y,
    })
    listLayout(left, Enum.FillDirection.Vertical, 10)

    local right = new("ScrollingFrame", {
        Parent                 = page,
        Name                   = "Right",
        Size                   = UDim2.new(0.5, -6, 1, 0),
        Position               = UDim2.new(0.5, 6, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        ScrollBarThickness     = 3,
        ScrollBarImageColor3   = Theme.Border,
        CanvasSize             = UDim2.new(),
        AutomaticCanvasSize    = Enum.AutomaticSize.Y,
        ScrollingDirection     = Enum.ScrollingDirection.Y,
    })
    listLayout(right, Enum.FillDirection.Vertical, 10)

    local tab = setmetatable({
        Window = self, Name = name, Button = btn, Page = page,
        Left = left, Right = right, Label = label, Icon = iconImg,
        Sections = {},
    }, Tab)

    btn.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            tween(btn, 0.14, { BackgroundTransparency = 0, BackgroundColor3 = Theme.Bg3 })
            tween(label, 0.14, { TextColor3 = Theme.Text })
            if iconImg then tween(iconImg, 0.14, { ImageColor3 = Theme.Text }) end
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            tween(btn, 0.14, { BackgroundTransparency = 1 })
            tween(label, 0.14, { TextColor3 = Theme.SubText })
            if iconImg then tween(iconImg, 0.14, { ImageColor3 = Theme.SubText }) end
        end
    end)
    btn.MouseButton1Click:Connect(function() self:SelectTab(tab) end)

    table.insert(self.Tabs, tab)
    if not self.ActiveTab then self:SelectTab(tab) end
    return tab
end

function Window:SelectTab(tab)
    for _, t in ipairs(self.Tabs) do
        local active = (t == tab)
        t.Page.Visible = active
        if active then
            tween(t.Button, 0.18, { BackgroundTransparency = 0, BackgroundColor3 = Theme.Accent })
            tween(t.Label,  0.18, { TextColor3 = Theme.AccentText })
            if t.Icon then tween(t.Icon, 0.18, { ImageColor3 = Theme.AccentText }) end
            t.Label.Font = FONT_SB
        else
            tween(t.Button, 0.18, { BackgroundTransparency = 1 })
            tween(t.Label,  0.18, { TextColor3 = Theme.SubText })
            if t.Icon then tween(t.Icon, 0.18, { ImageColor3 = Theme.SubText }) end
            t.Label.Font = FONT_M
        end
    end
    self.ActiveTab = tab
end

