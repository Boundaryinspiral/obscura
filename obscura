----------------------------------------------------------------------
-- THEMES (Material light × iOS, plus Dark variant)
----------------------------------------------------------------------
-- IMPORTANT: every value within a single theme MUST be unique. If two keys
-- share a Color3, the live remap can't tell them apart and theme switching
-- becomes ambiguous. AccentText/Shadow are intentionally offset by 1-2 RGB
-- units so they don't collide with Bg/Accent (visually identical).
local ThemeLight = {
    Bg          = Color3.fromRGB(255, 255, 255),
    Bg2         = Color3.fromRGB(247, 247, 249),
    Bg3         = Color3.fromRGB(238, 238, 242),
    Hover       = Color3.fromRGB(232, 232, 237),
    Border      = Color3.fromRGB(228, 228, 232),
    BorderHi    = Color3.fromRGB(199, 199, 204),
    Text        = Color3.fromRGB(28, 28, 30),
    SubText     = Color3.fromRGB(110, 110, 115),
    DimText     = Color3.fromRGB(174, 174, 178),
    Accent      = Color3.fromRGB(0, 0, 0),
    AccentText  = Color3.fromRGB(250, 250, 250),  -- unique vs Bg
    Track       = Color3.fromRGB(229, 229, 234),
    Shadow      = Color3.fromRGB(8, 8, 8),         -- unique vs Accent
}
local ThemeDark = {
    Bg          = Color3.fromRGB(16, 16, 19),     -- deep neutral
    Bg2         = Color3.fromRGB(24, 24, 27),     -- card / input
    Bg3         = Color3.fromRGB(34, 34, 38),     -- dropdown / pressed
    Hover       = Color3.fromRGB(44, 44, 48),
    Border      = Color3.fromRGB(36, 36, 40),
    BorderHi    = Color3.fromRGB(62, 62, 68),
    Text        = Color3.fromRGB(245, 245, 247),
    SubText     = Color3.fromRGB(160, 160, 168),
    DimText     = Color3.fromRGB(100, 100, 108),
    Accent      = Color3.fromRGB(255, 255, 255),
    AccentText  = Color3.fromRGB(8, 8, 10),        -- unique vs Bg/Shadow
    Track       = Color3.fromRGB(40, 40, 44),      -- unique vs Hover/Border
    Shadow      = Color3.fromRGB(0, 0, 0),
}

local Theme = {}
for k, v in pairs(ThemeLight) do Theme[k] = v end
Library.Theme       = Theme
Library.Themes      = { light = ThemeLight, dark = ThemeDark }
Library.CurrentTheme = "light"

-- Snap two Color3 if their components are within tolerance
local function colorEq(a, b)
    if not a or not b then return false end
    return math.abs(a.R - b.R) < 0.001
       and math.abs(a.G - b.G) < 0.001
       and math.abs(a.B - b.B) < 0.001
end

-- Tween a single property of an instance to `to` over `dur` seconds
local function _themeTween(inst, prop, to, dur)
    local ok = pcall(function()
        local tw = TS:Create(inst, TweenInfo.new(
            dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out
        ), { [prop] = to })
        tw:Play()
    end)
    if not ok then
        pcall(function() inst[prop] = to end)
    end
end

function Library:SetTheme(name, instant)
    local target = self.Themes[name] or self.Themes.light
    if not target then return end
    if self.CurrentTheme == name and not instant then return end

    -- snapshot old palette (we use these to identify which Theme key each
    -- existing color came from, then tween toward the matching new value)
    local old = {}
    for k, v in pairs(Theme) do old[k] = v end
    -- mutate Theme table in place so subsequent reads see the new palette
    for k, v in pairs(target) do Theme[k] = v end
    self.CurrentTheme = name

    local sg = self.ScreenGui
    if not sg then return end

    local function remap(c)
        if not c then return nil end
        for k, oldC in pairs(old) do
            if colorEq(c, oldC) then return target[k] end
        end
        return nil
    end

    local dur = instant and 0 or 0.25

    local function setOrTween(inst, prop, to)
        if not to then return end
        if dur <= 0 then
            pcall(function() inst[prop] = to end)
        else
            _themeTween(inst, prop, to, dur)
        end
    end

    local instances = sg:GetDescendants()
    table.insert(instances, sg)
    for _, inst in ipairs(instances) do
        if not inst:GetAttribute("ObsPreserve") then
            local cls = inst.ClassName
            if cls == "Frame" or cls == "TextButton" or cls == "TextBox"
            or cls == "ImageButton" or cls == "ImageLabel" or cls == "ScrollingFrame" then
                setOrTween(inst, "BackgroundColor3", remap(inst.BackgroundColor3))
            end
            if cls == "ScrollingFrame" then
                setOrTween(inst, "ScrollBarImageColor3", remap(inst.ScrollBarImageColor3))
            end
            if cls == "TextLabel" or cls == "TextButton" or cls == "TextBox" then
                setOrTween(inst, "TextColor3",        remap(inst.TextColor3))
                setOrTween(inst, "PlaceholderColor3", remap(inst.PlaceholderColor3))
            end
            if cls == "ImageLabel" or cls == "ImageButton" then
                setOrTween(inst, "ImageColor3", remap(inst.ImageColor3))
            end
            if cls == "UIStroke" then
                setOrTween(inst, "Color", remap(inst.Color))
            end
        end
    end
end

